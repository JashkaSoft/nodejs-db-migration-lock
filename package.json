{
  "name": "nodejs-db-migration-lock",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Node.js database migration lock packages",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "build": "lerna run build",
    "clean": "lerna run clean",
    "test": "lerna run test",
    "test:e2e": "npm run test:e2e:postgres && npm run test:e2e:mysql && npm run test:e2e:typeorm && npm run test:e2e:sequelize && npm run test:e2e:sqlite && npm run test:e2e:mssql && npm run test:e2e:cockroach && npm run test:e2e:yugabyte && npm run test:e2e:oracle && npm run test:e2e:mikroorm && npm run test:e2e:kysely",
    "test:e2e:postgres": "lerna run test:e2e --scope=@nodejs-db-migration-lock/postgres --stream",
    "test:e2e:postgres:node-pg": "lerna run test:e2e:node-pg --scope=@nodejs-db-migration-lock/postgres --stream",
    "test:e2e:mysql": "lerna run test:e2e --scope=@nodejs-db-migration-lock/mysql --stream",
    "test:e2e:mysql:mysql2": "lerna run test:e2e:mysql2 --scope=@nodejs-db-migration-lock/mysql --stream",
    "test:e2e:typeorm": "lerna run test:e2e --scope=@nodejs-db-migration-lock/typeorm --stream",
    "test:e2e:typeorm:postgres": "lerna run test:e2e:postgres --scope=@nodejs-db-migration-lock/typeorm --stream",
    "test:e2e:typeorm:mysql": "lerna run test:e2e:mysql --scope=@nodejs-db-migration-lock/typeorm --stream",
    "test:e2e:sequelize": "lerna run test:e2e --scope=@nodejs-db-migration-lock/sequelize --stream",
    "test:e2e:sequelize:postgres": "lerna run test:e2e:postgres --scope=@nodejs-db-migration-lock/sequelize --stream",
    "test:e2e:sequelize:mysql": "lerna run test:e2e:mysql --scope=@nodejs-db-migration-lock/sequelize --stream",
    "test:e2e:sqlite": "lerna run test:e2e --scope=@nodejs-db-migration-lock/sqlite --stream",
    "test:e2e:sqlite:node-sqlite": "lerna run test:e2e:node-sqlite --scope=@nodejs-db-migration-lock/sqlite --stream",
    "test:e2e:mssql": "lerna run test:e2e --scope=@nodejs-db-migration-lock/mssql --stream",
    "test:e2e:mssql:tedious": "lerna run test:e2e:tedious --scope=@nodejs-db-migration-lock/mssql --stream",
    "test:e2e:cockroach": "lerna run test:e2e --scope=@nodejs-db-migration-lock/cockroach --stream",
    "test:e2e:cockroach:pg": "lerna run test:e2e:pg --scope=@nodejs-db-migration-lock/cockroach --stream",
    "test:e2e:yugabyte": "lerna run test:e2e --scope=@nodejs-db-migration-lock/yugabyte --stream",
    "test:e2e:yugabyte:pg": "lerna run test:e2e:pg --scope=@nodejs-db-migration-lock/yugabyte --stream",
    "test:e2e:oracle": "lerna run test:e2e --scope=@nodejs-db-migration-lock/oracle --stream",
    "test:e2e:oracle:oracledb": "lerna run test:e2e:oracledb --scope=@nodejs-db-migration-lock/oracle --stream",
    "test:e2e:mikroorm": "lerna run test:e2e --scope=@nodejs-db-migration-lock/mikroorm --stream",
    "test:e2e:mikroorm:postgres": "lerna run test:e2e:postgres --scope=@nodejs-db-migration-lock/mikroorm --stream",
    "test:e2e:kysely": "lerna run test:e2e --scope=@nodejs-db-migration-lock/kysely --stream",
    "test:e2e:kysely:postgres": "lerna run test:e2e:postgres --scope=@nodejs-db-migration-lock/kysely --stream",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version": "lerna version",
    "publish": "lerna publish",
    "publish:ci": "lerna publish from-package --yes",
    "publish:git": "lerna publish from-git --yes --no-git-reset",
    "stage:git": "node scripts/stage-from-git.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lerna": "^10.1.1",
    "lint-staged": "17.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.15.0"
  },
  "overrides": {
    "undici": "^8.12.3"
  },
  "lint-staged": {
    "packages/**/*.ts": "eslint --fix --max-warnings=0"
  }
}
