{
  "name": "nodejs-db-migration-lock",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Node.js database migration lock packages",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "build": "lerna run build",
    "clean": "lerna run clean",
    "test": "lerna run test",
    "test:e2e": "npm run test:e2e:postgres && npm run test:e2e:mysql && npm run test:e2e:typeorm && npm run test:e2e:sequelize",
    "test:e2e:postgres": "lerna run test:e2e --scope=@nodejs-db-migration-lock/postgres --stream",
    "test:e2e:postgres:node-pg": "lerna run test:e2e:node-pg --scope=@nodejs-db-migration-lock/postgres --stream",
    "test:e2e:mysql": "lerna run test:e2e --scope=@nodejs-db-migration-lock/mysql --stream",
    "test:e2e:mysql:mysql2": "lerna run test:e2e:mysql2 --scope=@nodejs-db-migration-lock/mysql --stream",
    "test:e2e:typeorm": "lerna run test:e2e --scope=@nodejs-db-migration-lock/typeorm --stream",
    "test:e2e:typeorm:postgres": "lerna run test:e2e:postgres --scope=@nodejs-db-migration-lock/typeorm --stream",
    "test:e2e:typeorm:mysql": "lerna run test:e2e:mysql --scope=@nodejs-db-migration-lock/typeorm --stream",
    "test:e2e:sequelize": "lerna run test:e2e --scope=@nodejs-db-migration-lock/sequelize --stream",
    "test:e2e:sequelize:postgres": "lerna run test:e2e:postgres --scope=@nodejs-db-migration-lock/sequelize --stream",
    "test:e2e:sequelize:mysql": "lerna run test:e2e:mysql --scope=@nodejs-db-migration-lock/sequelize --stream",
    "lint": "lerna run lint",
    "version": "lerna version",
    "publish": "lerna publish",
    "publish:ci": "lerna publish from-package --yes"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "lerna": "^10.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "undici": "^8.12.3"
  }
}
