{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": [
    "migrate.ts",
    "verify.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "*.test.ts"
  ]
}
