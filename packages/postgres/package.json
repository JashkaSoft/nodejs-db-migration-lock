{
  "name": "@nodejs-db-migration-lock/postgres",
  "version": "0.1.0",
  "description": "PostgreSQL adapter for database migration locking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "jest --config tests/jest.config.unit.js",
    "test:unit": "jest --config tests/jest.config.unit.js",
    "test:watch": "jest --config tests/jest.config.unit.js --watch",
    "test:coverage": "jest --config tests/jest.config.unit.js --coverage",
    "test:e2e": "./tests/e2e/run-test.sh node-pg && ./tests/e2e/run-test.sh typeorm",
    "test:e2e:node-pg": "./tests/e2e/run-test.sh node-pg",
    "test:e2e:typeorm": "./tests/e2e/run-test.sh typeorm",
    "test:e2e:build": "./tests/e2e/run-test.sh node-pg",
    "test:e2e:down": "true",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "database",
    "migration",
    "lock",
    "postgres",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/nodejs-db-migration-lock.git",
    "directory": "packages/postgres"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nodejs-db-migration-lock/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  }
}
