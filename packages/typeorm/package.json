  },
  "dependencies": {
    "@nodejs-db-migration-lock/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typeorm": "0.3.31",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
