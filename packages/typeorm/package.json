    "test": "jest --config tests/jest.config.unit.js",
    "test:unit": "jest --config tests/jest.config.unit.js",
    "test:e2e": "./tests/e2e/run-test.sh postgres && ./tests/e2e/run-test.sh mysql",
    "test:e2e:postgres": "./tests/e2e/run-test.sh postgres",
